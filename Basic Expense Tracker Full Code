int main(void) {
    init_current_id();
    int choice;
    char username[MAXUSER] = "";

    while (1) {
        clear_screen();
        print_header("Basic Expense Tracker");

        printf("%s1.%s %sRegister%s\n", CYAN, RESET, BOLD YELLOW, RESET);
        printf("%s2.%s %sLogin%s\n", CYAN, RESET, BOLD YELLOW, RESET);
        printf("%s3.%s %sExit%s\n\n", CYAN, RESET, BOLD YELLOW, RESET);
        printf("%sChoose:%s ", YELLOW, RESET);

        if (scanf("%d", &choice) != 1) { while (getchar() != '\n'); continue; }
        while (getchar() != '\n');

        if (choice == 1) {
            register_user();
        } else if (choice == 2) {
            if (login_user(username)) {
                int opt = 0;
                while (opt != 9) {
                    clear_screen();
                    print_header("Main Menu");
                    printf("Logged in as: %s%s%s\n\n", GREEN, username, RESET);
                    printf("%s1.%s %sAdd Expense%s\n", CYAN, RESET, BOLD YELLOW, RESET);
                    printf("%s2.%s %sView Expenses %s\n", CYAN, RESET, BOLD YELLOW, RESET);
                    printf("%s3.%s %sEdit Expense%s\n", CYAN, RESET, BOLD YELLOW, RESET);
                    printf("%s4.%s %sDelete Expense%s\n", CYAN, RESET, BOLD YELLOW, RESET);
                    printf("%s5.%s %sMonthly Summary%s\n", CYAN, RESET, BOLD YELLOW, RESET);
                    printf("%s6.%s %sYearly Summary%s\n", CYAN, RESET, BOLD YELLOW, RESET);
                    printf("%s7.%s %sLogout%s\n", CYAN, RESET, BOLD YELLOW, RESET);
                    printf("%s8.%s %sExit%s\n", CYAN, RESET, BOLD YELLOW, RESET);
                    printf("\n%sChoose:%s ", YELLOW, RESET);

                    if (scanf("%d", &opt) != 1) { while (getchar() != '\n'); opt = 0; }
                    while (getchar() != '\n');

                    switch (opt) {
                        case 1: add_expense(username); break;
                        case 2: view_expenses_by_date(username); break;
                        case 3: edit_expense(username); break;
                        case 4: delete_expense(username); break;
                        case 5: monthly_summary(username); break;
                        case 6: yearly_summary(username); break;
                        case 7: opt = 9; break; // logout
                        case 8: printf("%s Exiting Goodbye!%s\n", CYAN, RESET); exit(0);
                        default: printf("%sInvalid option.%s\n", RED, RESET); pause_prompt();
                    }
                }
            }
        } else if (choice == 3) {
            printf("%sGoodbye!%s\n", CYAN, RESET);
            break;
        } else {
            printf("%sInvalid choice.%s\n", RED, RESET);
            pause_prompt();
        }
    }
    return 0;
}
