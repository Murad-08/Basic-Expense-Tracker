void clear_screen(void) {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}
void pause_prompt(void) {
    printf("\n%sPress Enter to continue...%s", CYAN, RESET);
    while (getchar() != '\n');
}
void print_header(const char *title) {
    printf("%s========================================%s\n", MAGENTA, RESET);
    printf("%s|    %-34s|\n", MAGENTA, title, RESET);
    printf("%s========================================%s\n\n", MAGENTA, RESET);
}
void trim_newline(char *s) {
    if (!s) return;
    size_t n = strlen(s);
    if (n && s[n - 1] == '\n') s[n - 1] = '\0';
}
int confirm_prompt(const char *msg) {
    char c;
    printf("%s%s (y/n): %s", YELLOW, msg, RESET);
    c = getchar();
    while (getchar() != '\n');
    return (c == 'y' || c == 'Y');
}
int get_password(char *buf, size_t size) {
#ifdef _WIN32
    int i = 0;
    char c;
    while ((c = _getch()) != '\r' && i < (int)size - 1) {
        if (c == '\b' && i > 0) { i--; printf("\b \b"); }
        else if (c >= 32) { buf[i++] = c; printf("*"); }
    }
    buf[i] = '\0';
    printf("\n");
#else
    struct termios oldt, newt;
    if (tcgetattr(STDIN_FILENO, &oldt) != 0) {
        // Fallback to fgets if termios not available
        if (!fgets(buf, size, stdin)) return 0;
        trim_newline(buf);
        return 1;
    }
    newt = oldt;
    newt.c_lflag &= ~(ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);
    if (!fgets(buf, size, stdin)) {
        tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
        return 0;
    }
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    trim_newline(buf);
    printf("\n");
#endif
    return 1;
}
int parse_date(const char *s, int *d, int *m, int *y) {
    if (!s) return 0;
    if (sscanf(s, "%d-%d-%d", d, m, y) == 3) return 1;
    if (sscanf(s, "%d/%d/%d", d, m, y) == 3) return 1;
    return 0;
}
int parse_month_year(const char *s, int *m, int *y) {
    if (!s) return 0;
    if (sscanf(s, "%d-%d", m, y) == 2) return 1;
    if (sscanf(s, "%d/%d", m, y) == 2) return 1;
    return 0;
}
int user_exists(const char *username) {
    FILE *f = fopen(USERS_FILE, "r");
    if (!f) return 0;
    User u;
    while (fscanf(f, "%31s %31s", u.username, u.password) == 2) {
        if (strcmp(u.username, username) == 0) { fclose(f); return 1; }
    }
    fclose(f);
    return 0;
}

int register_user(void) {
    User u;
    clear_screen();
    print_header("Register");
    printf("%sEnter username:%s ", YELLOW, RESET);
    if (!fgets(u.username, sizeof(u.username), stdin)) return 0;
    trim_newline(u.username);
    if (strlen(u.username) == 0) {
        printf("%sUsername cannot be empty!%s\n", RED, RESET);
        pause_prompt();
        return 0;
    }
    if (user_exists(u.username)) {
        printf("%sUser already exists!%s\n", RED, RESET);
        pause_prompt();
        return 0;
    }
    printf("%sEnter password:%s ", YELLOW, RESET);
    get_password(u.password, sizeof(u.password));

    if (strlen(u.password) < 8) {
        printf("%sPassword too short!%s\n", RED, RESET);
        pause_prompt();
        return 0;
    }

    FILE *f = fopen(USERS_FILE, "a");
    if (!f) { perror("Cannot open users file"); pause_prompt(); return 0; }
    fprintf(f, "%s %s\n", u.username, u.password);
    fclose(f);
    printf("%sRegistration completed successfully!%s\n", GREEN, RESET);
    pause_prompt();
    return 1;
}
int check_credentials(const char *username, const char *password) {
    FILE *f = fopen(USERS_FILE, "r");
    if (!f) return 0;
    User u;
    while (fscanf(f, "%31s %31s", u.username, u.password) == 2) {
        if (strcmp(u.username, username) == 0 && strcmp(u.password, password) == 0) {
            fclose(f);
            return 1;
        }
    }
    fclose(f);
    return 0;
}
int login_user(char *out_username) {
    char uname[MAXUSER], pass[MAXPASS];
    int attempts = 3;
    while (attempts--) {
        clear_screen();
        print_header("Login");
        printf("%sUsername:%s ", YELLOW, RESET);
        if (!fgets(uname, sizeof(uname), stdin)) return 0;
        trim_newline(uname);
        printf("%sPassword:%s ", YELLOW, RESET);
        get_password(pass, sizeof(pass));
        if (check_credentials(uname, pass)) {
            strcpy(out_username, uname);
            printf("%sLogin successful!%s\n", GREEN, RESET);
            pause_prompt();
            return 1;
        } else {
            printf("%sInvalid username or password!%s\n", RED, RESET);
            if (attempts > 0)
                printf("%sTry again (%d attempts left).%s\n", YELLOW, attempts, RESET);
            pause_prompt();
        }
    }
    printf("%sToo many failed attempts. Returning to UI.%s\n", RED, RESET);
    pause_prompt();
    return 0;
}
void init_current_id(void) {
    FILE *f = fopen(EXP_FILE, "r");
    if (!f) { current_id = 0; return; }
    Expense e;
    int maxid = 0;
    while (fscanf(f, "%d %31s %d %d %d %31s %lf",
                  &e.id, e.username, &e.day, &e.month, &e.year,
                  e.category, &e.amount) == 7) {
        if (e.id > maxid) maxid = e.id;
    }
    fclose(f);
    current_id = maxid;
}
int next_expense_id(void) {
    return ++current_id;
}

int get_next_expense_id(const char *username) {
    FILE *f = fopen(EXP_FILE, "r");
    if (!f) return 1;
    Expense e;
    int maxid = 0;
    while (fscanf(f, "%d %31s %d %d %d %31s %lf",
                  &e.id, e.username, &e.day, &e.month, &e.year,
                  e.category, &e.amount) == 7) {
        if (strcmp(e.username, username) == 0 && e.id > maxid)
            maxid = e.id;
    }
    fclose(f);
    return maxid + 1;
}
int add_expense(const char *username) {
    char choice = 'y';
    int first = 1;
    while (choice == 'y' || choice == 'Y') {
        Expense e;
        if (first) {
            clear_screen();
            print_header("Add Expense");
            first = 0;
        }
        e.id = get_next_expense_id(username);
        strncpy(e.username, username, MAXUSER);
        printf("\n%s--------------------------------------------------%s\n", YELLOW, RESET);
        char datebuf[32];
        printf("Enter date (dd-mm-yyyy): ");
        if (!fgets(datebuf, sizeof(datebuf), stdin)) {
            printf("%sInvalid input!%s\n", RED, RESET);
            pause_prompt();
            return 0;
        }
        trim_newline(datebuf);
        if (!parse_date(datebuf, &e.day, &e.month, &e.year)) {
            printf("%sInvalid date format!%s\n", RED, RESET);
            pause_prompt();
            return 0;
        }
        if (e.month < 1 || e.month > 12) {
            printf("%sInvalid month! Must be 1-12.%s\n", RED, RESET);
            pause_prompt();
            return 0;
        }
        if (e.day < 1 || e.day > 31) {
            printf("%sInvalid day! Must be 1-31.%s\n", RED, RESET);
            pause_prompt();
            return 0;
        }
        time_t t = time(NULL);
        struct tm *now = localtime(&t);
        if (e.year > (now->tm_year + 1900)) {
            printf("%sInvalid! Future year not allowed.%s\n", RED, RESET);
            pause_prompt();
            return 0;
        }

        printf("Category: ");
        if (!fgets(e.category, sizeof(e.category), stdin)) {
            printf("%sInvalid input!%s\n", RED, RESET);
            pause_prompt();
            return 0;
        }
        trim_newline(e.category);
        printf("Amount: ");
        if (scanf("%lf", &e.amount) != 1) {
            while (getchar() != '\n');
            printf("%sInvalid amount!%s\n", RED, RESET);
            pause_prompt();
            return 0;
        }
        while (getchar() != '\n');
        FILE *f = fopen(EXP_FILE, "a");
        if (!f) {
            perror("Cannot open expenses file");
            pause_prompt();
            return 0;
        }
        fprintf(f, "%d %s %d %d %d %s %.2f\n",
                e.id, e.username, e.day, e.month, e.year, e.category, e.amount);
        fclose(f);
        printf("%sExpense added successfully! (ID %04d)%s\n", GREEN, e.id, RESET);
        int invalid_attempts = 0;
        while (1) {
            printf("\nAdd another expense? (y/n): ");
            choice = getchar();
            while (getchar() != '\n');
            if (choice == 'y' || choice == 'Y' || choice == 'n' || choice == 'N')
                break;
            invalid_attempts++;
            printf("%sInvalid input! Please enter 'y' or 'n'.%s\n", RED, RESET);
            if (invalid_attempts >= 3) {
               printf("%sToo many invalid attempts!%s %sSaving and exiting...%s\n",
           RED, RESET, GREEN, RESET);
                choice = 'n'; 
                break;
            }
        }
    }

    printf("\n%sAll expenses saved successfully!%s\n", GREEN, RESET);
    pause_prompt();
    return 1;
}
int view_expenses_by_date(const char *username) {
    char datebuf[32];
    int d, m, y;
    clear_screen();
    print_header("  View Expenses ");
    printf("Enter date (dd-mm-yyyy): ");
    if (!fgets(datebuf, sizeof(datebuf), stdin)) { printf("%sInvalid input!%s\n", RED, RESET); pause_prompt(); return 0; }
    trim_newline(datebuf);
    if (!parse_date(datebuf, &d, &m, &y)) {
        printf("%sInvalid date!%s\n", RED, RESET);
        pause_prompt();
        return 0;
    }

    FILE *f = fopen(EXP_FILE, "r");
    if (!f) { printf("%sNo expenses found.%s\n", RED, RESET); pause_prompt(); return 0; }

    Expense e;
    int found = 0;
    printf("\n%sExpenses on %02d-%02d-%04d:%s\n", BLUE, d, m, y, RESET);
    printf("---------------------------------------------\n");
    while (fscanf(f, "%d %31s %d %d %d %31s %lf",
                  &e.id, e.username, &e.day, &e.month, &e.year, e.category, &e.amount) == 7) {
        if (strcmp(e.username, username) == 0 && e.day == d && e.month == m && e.year == y) {
            printf("ID:%02d | %s | %.2f\n", e.id, e.category, e.amount);
            found = 1;
        }
    }
    fclose(f);

    if (!found) printf("%sNo records found for that date.%s\n", RED, RESET);
    pause_prompt();
    return found;
}

int edit_expense(const char *username) {
    int id;
    clear_screen();
    print_header("Edit Expense");
    printf("Enter Expense ID to edit: ");
    if (scanf("%d", &id) != 1) { while (getchar() != '\n'); printf("%sInvalid ID!%s\n", RED, RESET); pause_prompt(); return 0; }
    while (getchar() != '\n');
    FILE *f = fopen(EXP_FILE, "r");
    if (!f) { printf("%sNo expenses file.%s\n", RED, RESET); pause_prompt(); return 0; }
    FILE *tmp = fopen("tmp.dat", "w");
    if (!tmp) { fclose(f); perror("Cannot open temp file"); pause_prompt(); return 0; }
    Expense e;
    int found = 0;
    while (fscanf(f, "%d %31s %d %d %d %31s %lf",
                  &e.id, e.username, &e.day, &e.month, &e.year, e.category, &e.amount) == 7) {
        if (e.id == id && strcmp(e.username, username) == 0) {
            found = 1;
            printf("Found: %02d-%02d-%04d | %s | %.2f\n", e.day, e.month, e.year, e.category, e.amount);
            if (!confirm_prompt("Edit this record?")) {
                fprintf(tmp, "%d %s %d %d %d %s %.2f\n",
                        e.id, e.username, e.day, e.month, e.year, e.category, e.amount);
                continue;
            }

            char buf[64];
            printf("New date (dd-mm-yyyy): ");
            if (fgets(buf, sizeof(buf), stdin)) {
                trim_newline(buf);
                if (strlen(buf) > 0) parse_date(buf, &e.day, &e.month, &e.year);
            }

            printf("New category: ");
            if (fgets(buf, sizeof(buf), stdin)) {
                trim_newline(buf);
                if (strlen(buf) > 0) strncpy(e.category, buf, MAXCAT);
            }

            printf("New amount: ");
            double a;
            if (scanf("%lf", &a) == 1 && a > 0) e.amount = a;
            while (getchar() != '\n');
            printf("%sExpense updated successfully.%s\n", GREEN, RESET);
        }
        fprintf(tmp, "%d %s %d %d %d %s %.2f\n", e.id, e.username, e.day, e.month, e.year, e.category, e.amount);
    }

    fclose(f);
    fclose(tmp);
    remove(EXP_FILE);
    rename("tmp.dat", EXP_FILE);
    if (!found) printf("%sRecord not found.%s\n", RED, RESET);
    pause_prompt();
    return found;
}

