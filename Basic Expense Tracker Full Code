    fclose(f);
    fclose(tmp);
    remove(EXP_FILE);
    rename("tmp.dat", EXP_FILE);
    if (!found) printf("%sRecord not found.%s\n", RED, RESET);
    pause_prompt();
    return found;
}
int monthly_summary(const char *username) {
    int month, year;
    char buf[64];
    clear_screen();
    print_header("Monthly Summary");
    printf("Enter month and year (mm-yyyy): ");
    if (!fgets(buf, sizeof(buf), stdin)) { printf("%sInvalid input!%s\n", RED, RESET); pause_prompt(); return 0; }
    trim_newline(buf);

    if (!parse_month_year(buf, &month, &year)) {
        printf("%sInvalid input format! Use mm-yyyy or mm/yyyy.%s\n", RED, RESET);
        pause_prompt();
        return 0;
    }
    if (month < 1 || month > 12) {
        printf("%sInvalid month! Must be 1-12.%s\n", RED, RESET);
        pause_prompt();
        return 0;
    }

    time_t t = time(NULL);
    struct tm *now = localtime(&t);
    if (year > (now->tm_year + 1900)) {
        printf("%sInvalid year! Future year not allowed.%s\n", RED, RESET);
        pause_prompt();
        return 0;
    }

    FILE *f = fopen(EXP_FILE, "r");
    if (!f) { printf("%sNo expenses file.%s\n", RED, RESET); pause_prompt(); return 0; }

    Expense e;
    double total = 0;
    int count = 0;
    printf("%s\nExpenses for %02d/%04d:%s\n", BLUE, month, year, RESET);
    printf("---------------------------------------------\n");
    while (fscanf(f, "%d %31s %d %d %d %31s %lf",
                  &e.id, e.username, &e.day, &e.month, &e.year, e.category, &e.amount) == 7) {
        if (strcmp(e.username, username) == 0 && e.month == month && e.year == year) {
            printf("%02d-%02d-%04d | %s | %.2f\n", e.day, e.month, e.year, e.category, e.amount);
            total += e.amount;
            count++;
        }
    }
    fclose(f);
    printf("---------------------------------------------\nTotal: %.2f | Count: %d\n", total, count);
    pause_prompt();
    return 1;
}

