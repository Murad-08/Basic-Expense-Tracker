#define USERS_FILE "users.dat"
#define EXP_FILE   "expenses.dat"
#define MAXUSER    32
#define MAXPASS    32
#define MAXCAT     32
#define RESET   "\x1b[0m"
#define RED     "\x1b[31m"
#define GREEN   "\x1b[32m"
#define YELLOW  "\x1b[33m"
#define BLUE    "\x1b[34m"
#define MAGENTA "\x1b[35m"
#define CYAN    "\x1b[36m"
#define BOLD    "\x1b[1m"

typedef struct {
    char username[MAXUSER];
    char password[MAXPASS];
} User;
typedef struct {
    int id;
    char username[MAXUSER];
    int day, month, year;
    char category[MAXCAT];
    double amount;
} Expense;
